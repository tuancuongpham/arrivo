{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@brottin/arrivo": ["./src/index.ts"],
      "@brottin/arrivo/core": ["./src/core/index.ts"],
      "@brottin/arrivo/effects": ["./src/effects/index.ts"]
    }
  },
  "include": ["src", "playground/src", "test/unit"]
}
