{
  "name": "arrivo",
  "version": "0.1.0",
  "description": "Loading effects for React that reveal real content in place: split-flap, redacted, quadtree mosaic, CMYK halftone, CRT tune-in, ink threshold maps, particle swarm and more.",
  "author": "Tuan Cuong Pham",
  "homepage": "https://tuancuongpham.github.io/arrivo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuancuongpham/arrivo.git"
  },
  "bugs": {
    "url": "https://github.com/tuancuongpham/arrivo/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./effects": {
      "import": {
        "types": "./dist/effects/index.d.ts",
        "default": "./dist/effects/index.js"
      },
      "require": {
        "types": "./dist/effects/index.d.cts",
        "default": "./dist/effects/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core/index.d.ts"
      ],
      "effects": [
        "./dist/effects/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "react",
    "loading",
    "loading-state",
    "skeleton",
    "placeholder",
    "reveal",
    "animation",
    "canvas",
    "split-flap",
    "halftone",
    "mosaic"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/use-client.mjs && node scripts/fix-types.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:playground": "vite build --config playground/vite.config.ts",
    "preview": "vite preview --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench": "node scripts/bench.mjs"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
